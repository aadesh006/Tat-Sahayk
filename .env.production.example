# Compose deployment identity
COMPOSE_PROJECT_NAME=tat-sahayk-production

# Only the frontend is exposed publicly
FRONTEND_PORT=8080

# PostgreSQL
POSTGRES_DB=tat_sahayk
POSTGRES_USER=tat_sahayk
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# Keep the password URL-encoded if it contains reserved URL characters.
DATABASE_URL=postgresql+psycopg2://tat_sahayk:replace-with-a-strong-url-safe-password@db:5432/tat_sahayk
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API directly.
# Same-origin requests through Nginx do not require CORS.
CORS_ORIGINS=https://your-domain.example

# AI provider: local | bedrock | hybrid
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false
ML_SERVICE_TIMEOUT_SECONDS=30

# Phone OTP: disabled | sns
# Console delivery is deliberately rejected in production.
PHONE_OTP_PROVIDER=disabled
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5

# Media storage: local | s3
MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif

# Optional background analysis
ENABLE_SOCIAL_HARVESTER=true
ENABLE_CLUSTER_ANALYSIS=false
SOCIAL_HARVEST_INTERVAL_MINUTES=15
CLUSTER_ANALYSIS_INTERVAL_MINUTES=15

# Google OAuth web client
GOOGLE_CLIENT_ID=

# AWS is required only for Bedrock, S3, SES or SNS features
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_BEDROCK_TEXT_MODEL_ID=us.amazon.nova-micro-v1:0
SES_SOURCE_EMAIL=

# Optional external services
OPENWEATHER_API_KEY=
STORMGLASS_API_KEY=
TAVILY_API_KEY=
