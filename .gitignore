# macOS
.DS_Store
**/.DS_Store

# Environment files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

!.env.production.example
!**/.env.production.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
**/venv/

# Python build artifacts
build/
dist/
*.egg-info/

# Node/Vite
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local databases
*.db
*.sqlite
*.sqlite3

# User-uploaded media
backend/uploads/*
!backend/uploads/.gitkeep

# ML runtime artifacts
ml-service/logs/
ml-service/data/raw/
ml-service/data/processed/
