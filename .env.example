# Docker Compose project
COMPOSE_PROJECT_NAME=tat-sahayk-prototype

# PostgreSQL/PostGIS
POSTGRES_DB=tat_sahayk
POSTGRES_USER=tat_sahayk
POSTGRES_PASSWORD=tat_sahayk_local_password
POSTGRES_PORT=5432

# Exposed service ports
FRONTEND_PORT=8080
BACKEND_PORT=5001
ML_SERVICE_PORT=8000

# Generate a stronger value with:
# openssl rand -hex 32
SECRET_KEY=local-development-secret-change-before-deployment

# AI provider: local | bedrock | hybrid
AI_PROVIDER=local
AI_FALLBACK_ENABLED=false

# Phone OTP: disabled | console | sns
# Console mode returns the code only to the authenticated development user.
PHONE_OTP_PROVIDER=console
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5

# Optional external APIs
OPENWEATHER_API_KEY=
STORMGLASS_API_KEY=
TAVILY_API_KEY=

# Optional AWS configuration
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
GOOGLE_CLIENT_ID=

# Media storage: local | s3
MEDIA_STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=uploads
LOCAL_MEDIA_URL=/uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
